flowchart TD
    START["Tick Start"] --> SNAP["ContextPressure snapshot"]
    SNAP --> CRIT{"remaining\n< hardLimit?"}
    CRIT -->|Yes| KILL["Kill agent\nbefore produceSync()"]
    CRIT -->|No| PRODUCE["produceSync()"]
    PRODUCE --> STOP{"isStop?"}
    STOP -->|No| COLLECT["Collect token\nfor batch commit"]
    STOP -->|Yes| PARSE["parseChatOutput"]
    PARSE --> GATES{"beforeDispatch gates\nframe (auth) · tool · harness"}
    GATES -->|refused| INJECT["Nudge in the call's place\n(booked, not attended)"]
    GATES -->|passed| POLICY["policy.onProduced()"]
    POLICY -->|report| DONE["reportResult + idle"]
    POLICY -->|tool_call| DISPATCH["Queue for DISPATCH\n(re-gated if the call changed)"]
    POLICY -->|over budget| SOFTCUT["Nudge or kill\n(pressure_softcut)"]

    COLLECT --> COMMIT["store.commit()\nbatch decode"]
    COMMIT --> SETTLE["SETTLE: admit pending items"]
    SETTLE --> FIT{"cost\n<= headroom?"}
    FIT -->|Yes| PREFILL["store.prefill()\nbook · afterAdmit → follow-up?"]
    FIT -->|No, and nothing can free room| REJECT{"beforeAdmit\ntool · harness · frame"}
    REJECT -->|nudge| INJECT2["Replace with the nudge"]
    REJECT -->|drop| KILL2["Drop agent\n(pressure_settle_reject / settle_stall_break)"]

    DISPATCH --> EXEC["Tool executes"]
    EXEC --> AFTER{"afterExecute\ntool · harness · frame"}
    AFTER -->|attempt| RESULT["Result → pending item\n(next tick's SETTLE)"]
    AFTER -->|retry| PARK["Park; same call\nafter afterMs"]
    AFTER -->|fail| FAILED["Failure settles\nas the result"]

    style KILL fill:#e74c3c,color:#fff
    style KILL2 fill:#e74c3c,color:#fff
    style DONE fill:#2ecc71,color:#fff
    style COMMIT fill:#3498db,color:#fff
    style PREFILL fill:#3498db,color:#fff
